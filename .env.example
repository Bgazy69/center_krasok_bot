# Токен от @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Groq API — ключ из https://console.groq.com/ (начинается с gsk_)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Сколько пар сообщений хранить в контексте (user+assistant)
MAX_HISTORY_MESSAGES=10

# Лимит длины ответа в Telegram
MAX_REPLY_CHARS=3500
