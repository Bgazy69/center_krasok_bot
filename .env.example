# Токен от @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Google Gemini API — ключ из https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Сколько пар сообщений хранить в контексте (user+assistant)
MAX_HISTORY_MESSAGES=10

# Лимит длины ответа в Telegram
MAX_REPLY_CHARS=3500
